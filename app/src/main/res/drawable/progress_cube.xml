<!-- CubeOS: slim rounded progress bar; the fill keeps its rounded ends as it grows. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="3dp" />
            <solid android:color="@color/cube_fill" />
        </shape>
    </item>
    <item android:id="@android:id/secondaryProgress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <solid android:color="@color/cube_fill" />
            </shape>
        </scale>
    </item>
    <item android:id="@android:id/progress">
        <scale android:scaleWidth="100%">
            <shape android:shape="rectangle">
                <corners android:radius="3dp" />
                <gradient
                    android:type="linear"
                    android:angle="0"
                    android:startColor="@color/cube_brand_start"
                    android:centerColor="@color/cube_brand_center"
                    android:endColor="@color/cube_brand_end" />
            </shape>
        </scale>
    </item>
</layer-list>

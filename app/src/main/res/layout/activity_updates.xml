     CubeOS: Cube Update. A hero (brand tile, version, status, Check for Updates), the update
     card, then Automatic Updates. Grouped background, 24dp cards, no stock Material look.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:id="@+id/content_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/app_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/background">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:theme="?android:attr/actionBarTheme"
                app:contentInsetStartWithNavigation="0dp">

                <TextView
                    android:id="@+id/toolbar_title"
                    style="@style/CubeText.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:alpha="0"
                    android:text="@string/display_name" />
            </androidx.appcompat.widget.Toolbar>

            <View
                android:id="@+id/toolbar_divider"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:layout_gravity="bottom"
                android:alpha="0"
                android:background="@color/cube_separator" />
        </FrameLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/scroll_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="40dp">

                <!-- Hero -->
                <LinearLayout
                    android:id="@+id/header_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="32dp"
                    android:paddingBottom="32dp">

                    <ImageView
                        android:id="@+id/header_icon"
                        android:layout_width="96dp"
                        android:layout_height="96dp"
                        android:background="@drawable/bg_cube_tile_large"
                        android:contentDescription="@null"
                        android:elevation="8dp"
                        android:outlineAmbientShadowColor="@color/cube_brand_center"
                        android:outlineSpotShadowColor="@color/cube_brand_center"
                        android:padding="20dp"
                        android:src="@drawable/ic_cube_glyph" />

                    <TextView
                        android:id="@+id/header_title"
                        style="@style/CubeText.LargeTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        tools:text="CubeOS 1.0" />

                    <TextView
                        android:id="@+id/header_build_version"
                        style="@style/CubeText.Footnote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:textIsSelectable="true"
                        tools:text="Build 1.0-20261023-RELEASE" />

                    <LinearLayout
                        android:id="@+id/header_status"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="invisible"
                        tools:visibility="visible">

                        <ImageView
                            android:id="@+id/header_status_icon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:layout_marginEnd="8dp"
                            android:contentDescription="@null"
                            tools:src="@drawable/ic_status_check" />

                        <TextView
                            android:id="@+id/header_status_text"
                            style="@style/CubeText.Headline"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="CubeOS is up to date" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/header_last_check"
                        style="@style/CubeText.Footnote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        tools:text="Last checked today at 08:46" />

                    <LinearLayout
                        android:id="@+id/check_button"
                        style="@style/CubePill.Primary"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="24dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:orientation="horizontal">

                        <ProgressBar
                            android:id="@+id/check_progress"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="10dp"
                            android:indeterminate="true"
                            android:indeterminateTint="@color/cube_secondary_label"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/check_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:singleLine="true"
                            android:text="@string/action_check_for_updates"
                            android:textColor="@color/cube_on_accent"
                            android:textSize="17sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- The update card -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycler_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:visibility="gone"
                    tools:listitem="@layout/update_item_view"
                    tools:visibility="visible" />

                <!-- Kept for the shared list logic; on a phone the hero says "up to date". -->
                <View
                    android:id="@+id/no_new_updates_view"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <!-- Automatic Updates -->
                <TextView
                    android:id="@+id/auto_update_header"
                    style="@style/CubeText.SectionHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:paddingStart="36dp"
                    android:paddingEnd="36dp"
                    android:paddingBottom="8dp"
                    android:text="@string/auto_update_title" />

                <LinearLayout
                    android:id="@+id/auto_update_card"
                    style="@style/CubeCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToOutline="true"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/auto_update_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_row"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center_vertical"
                        android:minHeight="64dp"
                        android:orientation="horizontal"
                        android:paddingStart="20dp"
                        android:paddingTop="14dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="14dp">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/CubeText.Body"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/auto_update_switch" />

                            <TextView
                                style="@style/CubeText.Footnote"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="@string/auto_update_switch_summary" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/auto_update_switch"
                            style="@style/CubeSwitch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="false"
                            android:focusable="false"
                            android:importantForAccessibility="no" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/auto_update_mobile_group"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginStart="20dp"
                            android:background="@color/cube_separator" />

                        <LinearLayout
                            android:id="@+id/auto_update_mobile_row"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_row"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:minHeight="64dp"
                            android:orientation="horizontal"
                            android:paddingStart="20dp"
                            android:paddingTop="14dp"
                            android:paddingEnd="16dp"
                            android:paddingBottom="14dp">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    style="@style/CubeText.Body"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/auto_update_mobile" />

                                <TextView
                                    style="@style/CubeText.Footnote"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:text="@string/auto_update_mobile_summary" />
                            </LinearLayout>

                            <androidx.appcompat.widget.SwitchCompat
                                android:id="@+id/auto_update_mobile_switch"
                                style="@style/CubeSwitch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:clickable="false"
                                android:focusable="false"
                                android:importantForAccessibility="no" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/auto_update_footer"
                    style="@style/CubeText.Footnote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="36dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="36dp"
                    tools:text="@string/auto_update_footer_on_wifi" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>

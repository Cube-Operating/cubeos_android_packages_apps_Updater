    <string name="card_cubex_not_deployed">Can\'t verify on CUBEX yet. CubeOS\'s signature on this update was checked.</string>
    <string name="card_cubex_overridden">Not verified on CUBEX. It installs only because you chose Install Anyway.</string>
    <string name="card_cubex_no_record">Not published by CubeOS, so it was refused.</string>
    <string name="card_cubex_mismatch">This update doesn\'t match what CubeOS published, so it was refused.</string>
    <string name="card_cubex_revoked">CubeOS withdrew this update, so it was refused.</string>
